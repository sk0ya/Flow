<Window x:Class="Flow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Flow.ViewModels"
        xmlns:controls="clr-namespace:Flow.Views.Controls"
        xmlns:conv="clr-namespace:Flow.Converters"
        Title="Flow"
        Icon="Assets/Flow.ico"
        Height="760" Width="1360"
        MinHeight="620" MinWidth="1000"
        WindowStyle="None"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        FontFamily="Segoe UI">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveProjectCommand}"/>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoLastActionCommand}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoLastActionCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedItemCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddItemCommand}"/>
    </Window.InputBindings>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="8"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <conv:HmsConverter x:Key="HmsConv"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AppAccentSubtleBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AppAccentOutlineBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AppAccentSubtleStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentStrongBrush}"/>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBackground" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource AppAccentSubtleBrush}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource AppAccentSubtleStrongBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource InputComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"/>
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="▼" FontSize="8" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}"/>
                            </Grid>
                            <ToggleButton x:Name="PART_ToggleButton" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Focusable="False">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Rectangle Fill="Transparent"/></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                                <Border Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
                                    <ScrollViewer MaxHeight="220"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="PART_ToggleButton" Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AppAccentOutlineBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/><Setter TargetName="ComboBorder" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,12,0,5"/>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleButtonBackground" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleButtonBackground" Property="Background" Value="{DynamicResource AppAccentSubtleBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleBarButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ConditionChip" DataType="{x:Type vm:ConditionEntry}">
            <Border Margin="0,2,5,2"
                    Padding="8,4"
                    CornerRadius="12"
                    Background="{DynamicResource AppInfoSurfaceBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Value}"
                               FontSize="11"
                               Foreground="{DynamicResource AppInfoBrush}"
                               VerticalAlignment="Center"/>
                    <Button Content="×"
                            Margin="6,0,0,0"
                            Padding="0"
                            FontSize="12"
                            Foreground="{DynamicResource AppInfoBrush}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding DataContext.RemovePreConditionCommand,
                                              RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                            CommandParameter="{Binding}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PostConditionChip" DataType="{x:Type vm:ConditionEntry}">
            <Border Margin="0,2,5,2"
                    Padding="8,4"
                    CornerRadius="12"
                    Background="{DynamicResource AppSuccessSurfaceBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Value}"
                               FontSize="11"
                               Foreground="{DynamicResource AppSuccessBrush}"
                               VerticalAlignment="Center"/>
                    <Button Content="×"
                            Margin="6,0,0,0"
                            Padding="0"
                            FontSize="12"
                            Foreground="{DynamicResource AppSuccessBrush}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding DataContext.RemovePostConditionCommand,
                                              RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                            CommandParameter="{Binding}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Application header: file actions stay in one predictable place. -->
        <Border Grid.Row="0"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0" IsHitTestVisible="False">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AppAccentSubtleBrush}" BorderBrush="{DynamicResource AppAccentOutlineBrush}" BorderThickness="1" Margin="0,0,9,0">
                        <TextBlock Text="⬡" FontSize="17" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Flow" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        <TextBlock Text="タイムライン設計" FontSize="9" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="{Binding ProjectName}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding CurrentFilePath, TargetNullValue=未保存のプロジェクト}"
                               FontSize="10"
                               Foreground="{DynamicResource AppTextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding CurrentFilePath}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="新規" Style="{StaticResource ToolbarButton}" Command="{Binding NewProjectCommand}" ToolTip="新しいプロジェクト（変更前に確認）"/>
                    <Button Content="開く" Style="{StaticResource ToolbarButton}" Command="{Binding OpenProjectCommand}" ToolTip="プロジェクトを開く"/>
                    <Button x:Name="AppearanceButton" Content="外観" Style="{StaticResource ToolbarButton}" Click="OnAppearanceClick" ToolTip="カラーテーマとアクセントカラー"/>
                    <Button Content="保存" Style="{StaticResource PrimaryButton}" Command="{Binding SaveProjectCommand}" ToolTip="保存（Ctrl+S）"/>
                    <Border Width="1" Height="22" Background="{DynamicResource AppBorderBrush}" Margin="4,0,4,0"/>
                    <Button Style="{StaticResource TitleBarButton}" Click="OnMinimizeWindow" ToolTip="最小化">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE921;"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Click="OnToggleMaximizeWindow" ToolTip="最大化 / 元に戻す">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE922;"/>
                    </Button>
                    <Button Style="{StaticResource CloseTitleBarButton}" Click="OnCloseWindow" ToolTip="閉じる">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE8BB;"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Popup x:Name="AppearancePopup"
               PlacementTarget="{Binding ElementName=AppearanceButton}"
               Placement="Bottom"
               HorizontalOffset="0"
               VerticalOffset="6"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <Border Width="286"
                    Padding="14"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9">
                <StackPanel>
                    <TextBlock Text="外観" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    <TextBlock Text="アプリ全体の表示に反映されます。プロジェクトには保存されません。" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,12"/>
                    <TextBlock Text="カラーテーマ" Style="{StaticResource SectionLabel}"/>
                    <ComboBox ItemsSource="{Binding ThemeOptions}"
                              SelectedItem="{Binding SelectedThemeOption, Mode=TwoWay}"
                              Style="{StaticResource InputComboBox}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ThemeOption}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="アクセントカラー" Style="{StaticResource SectionLabel}"/>
                    <ComboBox ItemsSource="{Binding AccentColorOptions}"
                              SelectedItem="{Binding SelectedAccentColorOption, Mode=TwoWay}"
                              Style="{StaticResource InputComboBox}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AccentColorOption}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="{Binding SwatchBrush}" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Main workspace: timeline and one stable inspector. -->
        <Grid Grid.Row="1" Margin="16,14,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="520"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="350" MinWidth="300" MaxWidth="430"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="98"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- The timeline header explains the working model before exposing controls. -->
                <Border Grid.Row="0"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="10,10,0,0"
                        Padding="16,10,16,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="タイムライン" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                <TextBlock Text="{Binding FilterSummary}" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Background="{DynamicResource AppAccentSubtleBrush}" BorderBrush="{DynamicResource AppAccentOutlineBrush}" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="期間 " FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding ProjectDuration, Converter={StaticResource HmsConv}}"
                                               FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource AppWarningSurfaceBrush}" CornerRadius="8" Padding="8,3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Foreground="{DynamicResource AppWarningTextBrush}" FontSize="10">
                                    <Run Text="⚠ "/><Run Text="{Binding Errors.Count, Mode=OneWay}"/><Run Text=" 件"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="空白をドラッグして作成　　バーをドラッグして移動・期間変更"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>

                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="プロジェクト設定"
                                    Style="{StaticResource ToolbarButton}"
                                    Click="OnProjectSettingsClick"
                                    ToolTip="プロジェクト全体の設定"/>
                            <Button x:Name="TimelineScaleButton"
                                    Content="時間軸"
                                    Style="{StaticResource ToolbarButton}"
                                    Padding="9,4"
                                    Margin="0,0,8,0"
                                    Click="OnTimelineScaleClick"
                                    ToolTip="時間軸の単位・範囲・グリッド間隔を変更"/>
                            <TextBlock Text="倍率" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Content="−" Style="{StaticResource ToolbarButton}" Padding="8,4" Command="{Binding ZoomOutCommand}" ToolTip="時間軸を縮小"/>
                            <Button Command="{Binding ResetZoomCommand}"
                                    Background="{DynamicResource AppSurfaceAltBrush}"
                                    BorderThickness="0"
                                    Padding="8,5"
                                    Margin="3,0"
                                    ToolTip="標準の表示倍率に戻す">
                                <TextBlock Text="{Binding ZoomPercent, StringFormat={}{0:0}%}" FontSize="10" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            </Button>
                            <Button Content="＋" Style="{StaticResource ToolbarButton}" Padding="8,4" Command="{Binding ZoomInCommand}" ToolTip="時間軸を拡大"/>
                            <Button Content="＋ タスク" Style="{StaticResource PrimaryButton}" Padding="10,5" Margin="8,0,0,0" Command="{Binding AddItemCommand}" ToolTip="タスクを追加（Ctrl+N）"/>
                        </StackPanel>

                        <Popup x:Name="TimelineScalePopup"
                               PlacementTarget="{Binding ElementName=TimelineScaleButton}"
                               Placement="Bottom"
                               HorizontalOffset="0"
                               VerticalOffset="6"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <Border Width="318"
                                    Padding="14"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <StackPanel>
                                    <TextBlock Text="時間軸の表示" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    <TextBlock Text="目盛り・表示範囲・グリッド間隔を調整します。プロジェクト設定ではありません。" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="目盛りの単位" Style="{StaticResource SectionLabel}"/>
                                            <ComboBox ItemsSource="{x:Static vm:MainViewModel.TimeUnitOptions}"
                                                      SelectedItem="{Binding TimeUnit}"
                                                      Style="{StaticResource InputComboBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="表示範囲" Style="{StaticResource SectionLabel}"/>
                                            <TextBox Style="{StaticResource InputBox}" Text="{Binding TotalDuration, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="グリッド間隔" Style="{StaticResource SectionLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource InputBox}" Text="{Binding CellDurationText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CellDurationUnitLabel}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="{Binding CellDurationSummary}" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding CellDurationError}" FontSize="10" Foreground="{DynamicResource AppDangerBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBox x:Name="CanvasSearchBox"
                                     Width="220"
                                     Style="{StaticResource InputBox}"
                                     FontSize="11"
                                     ToolTip="タスク名・説明・レーンを検索"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="‹" Style="{StaticResource ToolbarButton}" Padding="9,4" Margin="5,0,0,0" Command="{Binding SelectPreviousMatchCommand}" ToolTip="前の検索結果へ移動"/>
                            <Button Content="›" Style="{StaticResource ToolbarButton}" Padding="9,4" Margin="2,0,10,0" Command="{Binding SelectNextMatchCommand}" ToolTip="次の検索結果へ移動"/>
                            <ComboBox Width="142"
                                      ItemsSource="{Binding CategoriesForFilter}"
                                      SelectedItem="{Binding SelectedFilterCategory, Mode=TwoWay}"
                                      Style="{StaticResource InputComboBox}"
                                      ToolTip="分類で絞り込む">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CategoryViewModel}">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Border Width="1" Height="20" Background="{DynamicResource AppBorderBrush}" Margin="10,0,10,0"/>
                            <CheckBox Content="エラーのみ"
                                      Margin="10,0,0,0"
                                      VerticalAlignment="Center"
                                      FontSize="11"
                                      Foreground="{DynamicResource AppTextSecondaryBrush}"
                                      IsChecked="{Binding ShowErrorsOnly}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="{DynamicResource AppSurfaceAltBrush}"
                        BorderBrush="{DynamicResource AppBorderSoftBrush}"
                        BorderThickness="1,0,1,1"
                        CornerRadius="0,0,10,10">
                    <controls:GanttCanvas x:Name="GanttView"
                                          ItemsSource="{Binding FilteredItems}"
                                          Edges="{Binding FilteredDependencyEdges}"
                                          SelectedItem="{Binding SelectedItem}"
                                          Lanes="{Binding Lanes}"
                                          Categories="{Binding Categories}"
                                          TimeUnit="{Binding TimeUnit}"
                                          CellDuration="{Binding CellDuration}"
                                          TotalDuration="{Binding TotalDuration}"
                                          PixelsPerUnit="{Binding PixelsPerUnit}"
                                          CursorLaneIndex="{Binding CursorLaneIndex}"
                                          CursorTime="{Binding CursorTime}"
                                          IsVisualMode="{Binding IsVisualMode}"
                                          IsVisualLineMode="{Binding IsVisualLineMode}"
                                          VisualAnchorLane="{Binding VisualAnchorLane}"
                                          VisualAnchorTime="{Binding VisualAnchorTime}"
                                          CriticalPathItemIds="{Binding CriticalPathItemIds}"
                                          SearchText="{Binding SearchHighlightText}"/>
                </Border>
            </Grid>

            <Border Grid.Column="2"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource AppSurfaceAltBrush}"
                            BorderBrush="{DynamicResource AppBorderSoftBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="10,10,0,0"
                            Padding="16,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="6" Height="20" CornerRadius="3" Background="{DynamicResource AppAccentBrush}" Margin="0,0,9,0"/>
                                <TextBlock Text="インスペクター" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="選択中のタスクを編集" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" Margin="15,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,14,16,20">
                            <!-- Empty inspector state also provides a compact project overview. -->
                            <Border Background="{DynamicResource AppSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource AppBorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="プロジェクト概要" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="タスク" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                            <TextBlock Text="{Binding Items.Count}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="レーン" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                            <TextBlock Text="{Binding Lanes.Count}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="期間" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                            <TextBlock Text="{Binding ProjectDuration, Converter={StaticResource HmsConv}}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- First-use path: the empty state is an action, not an explanation. -->
                            <Border Background="{DynamicResource AppAccentSubtleBrush}"
                                    BorderBrush="{DynamicResource AppAccentOutlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="最初のタスクを作成"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems}" Value="True"><Setter Property="Text" Value="タスクを選択または追加"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,5,0,10">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="名前を入力して追加するか、タイムラインの空き場所をクリックしてください。"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems}" Value="True"><Setter Property="Text" Value="編集したいタスクをタイムラインから選択してください。新しいタスクもここから追加できます。"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource InputBox}"
                                                 Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="タスク名">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding AddItemCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <Button Grid.Column="1" Content="追加" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Command="{Binding AddItemCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Selected task editor stays in this same location. -->
                            <Grid DataContext="{Binding SelectedItem}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="タスクの編集" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <Button Grid.Column="1" Content="削除" Style="{StaticResource ToolbarButton}" Foreground="{DynamicResource AppDangerBrush}" Padding="8,5"
                                                Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>

                                    <TextBlock Text="タスク名" Style="{StaticResource SectionLabel}" Margin="0,14,0,5"/>
                                    <TextBox Style="{StaticResource InputBox}" FontSize="14" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="開始" Style="{StaticResource SectionLabel}"/>
                                            <TextBox Style="{StaticResource InputBox}" Text="{Binding StartTime, Converter={StaticResource HmsConv}, UpdateSourceTrigger=LostFocus}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="所要時間" Style="{StaticResource SectionLabel}"/>
                                            <TextBox Style="{StaticResource InputBox}" Text="{Binding Duration, Converter={StaticResource HmsConv}, UpdateSourceTrigger=LostFocus}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="レーン" Style="{StaticResource SectionLabel}"/>
                                    <ComboBox ItemsSource="{Binding DataContext.Lanes, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding LaneId}"
                                              Style="{StaticResource InputComboBox}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppTextPrimaryBrush}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="分類" Style="{StaticResource SectionLabel}"/>
                                    <ComboBox ItemsSource="{Binding DataContext.CategoriesForPicker, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding CategoryId}"
                                              Style="{StaticResource InputComboBox}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CategoryViewModel}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="10" Height="10" Fill="{Binding Brush}" Margin="0,0,7,0"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="説明" Style="{StaticResource SectionLabel}"/>
                                    <TextBox Style="{StaticResource InputBox}" MinHeight="58" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="開始条件" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppInfoBrush}"/>
                                            <Border Background="{DynamicResource AppInfoSurfaceBrush}" CornerRadius="8" Padding="5,1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding PreConditions.Count}" FontSize="9" Foreground="{DynamicResource AppInfoBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="前に必要" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding PreConditions}" ItemTemplate="{StaticResource ConditionChip}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="PreCondInputBox" Style="{StaticResource InputBox}" Text="{Binding NewPreCondition, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="OnPreCondInputChanged" LostFocus="OnCondInputLostFocus" PreviewKeyDown="OnCondInputKeyDown">
                                            <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding AddPreConditionCommand}"/></TextBox.InputBindings>
                                        </TextBox>
                                        <Button Grid.Column="1" Content="追加" Style="{StaticResource ToolbarButton}" Margin="5,0,0,0" Command="{Binding AddPreConditionCommand}"/>
                                    </Grid>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="完了条件" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppSuccessBrush}"/>
                                            <Border Background="{DynamicResource AppSuccessSurfaceBrush}" CornerRadius="8" Padding="5,1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding PostConditions.Count}" FontSize="9" Foreground="{DynamicResource AppSuccessBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="後に成立" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding PostConditions}" ItemTemplate="{StaticResource PostConditionChip}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="PostCondInputBox" Style="{StaticResource InputBox}" Text="{Binding NewPostCondition, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="OnPostCondInputChanged" LostFocus="OnCondInputLostFocus" PreviewKeyDown="OnCondInputKeyDown">
                                            <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding AddPostConditionCommand}"/></TextBox.InputBindings>
                                        </TextBox>
                                        <Button Grid.Column="1" Content="追加" Style="{StaticResource ToolbarButton}" Margin="5,0,0,0" Command="{Binding AddPostConditionCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Validation feedback is visible without stealing the workspace. -->
        <Border Grid.Row="2" Background="{DynamicResource AppWarningSurfaceBrush}" BorderBrush="{DynamicResource AppWarningBorderBrush}" BorderThickness="0,1,0,0" MaxHeight="92">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasErrors}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="18,5">
                <ItemsControl ItemsSource="{Binding Errors}">
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource AppWarningTextBrush}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource AppAccentBrush}" Padding="10,0" MinWidth="78">
                    <TextBlock Text="{Binding VimModeLabel}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppAccentTextBrush}" FontFamily="Consolas" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="表示 " FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"/>
                    <TextBlock Text="{Binding FilterSummary}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="2,0,12,0"/>
                    <TextBlock Text="レーン " FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"/>
                    <TextBlock Text="{Binding CursorLaneNumber}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="2,0,10,0"/>
                    <TextBlock Text="時刻 " FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"/>
                    <TextBlock Text="{Binding CursorTime, Converter={StaticResource HmsConv}}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="2,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Popup x:Name="SuggestionsPopup" Grid.RowSpan="4" Placement="Bottom" AllowsTransparency="True" StaysOpen="False">
            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" MinWidth="200" MaxWidth="300">
                <StackPanel>
                    <Border Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="8,8,0,0" Padding="10,6">
                        <TextBlock x:Name="SuggestionHeader" Text="候補" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" FontWeight="SemiBold"/>
                    </Border>
                    <ListBox x:Name="SuggestionsListBox" MaxHeight="180" BorderThickness="0" Background="Transparent" PreviewMouseDown="OnSuggestionClicked">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SuggestionItem}">
                                <StackPanel Margin="10,7">
                                    <TextBlock Text="{Binding Value}" FontSize="12" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Source, StringFormat='← {0}'}" FontSize="9" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
