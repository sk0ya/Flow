<UserControl x:Class="Flow.Views.Controls.GanttCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="GanttLayoutGrid" Background="{DynamicResource AppSurfaceAltBrush}" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" MinWidth="60"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

            <Border x:Name="FrozenCornerHeader"
                Grid.Row="0"
                Grid.Column="0"
                Background="{DynamicResource AppSurfaceMutedBrush}"
                BorderBrush="{DynamicResource AppBorderStrongBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="レーン"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Text=" / タスク"
                           FontSize="10"
                           Foreground="{DynamicResource AppTextMutedBrush}"/>
            </StackPanel>
        </Border>

        <Canvas x:Name="FrozenTimeHeaderCanvas"
                Grid.Row="0"
                Grid.Column="1"
                Background="{DynamicResource AppSurfaceMutedBrush}"
                ClipToBounds="True"/>

        <Canvas x:Name="FrozenLaneCanvas"
                Grid.Row="1"
                Grid.Column="0"
                Background="{DynamicResource AppSurfaceAltBrush}"
                ClipToBounds="True"/>

        <ScrollViewer x:Name="TimelineScrollViewer"
                      Grid.Row="1"
                      Grid.Column="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource AppSurfaceAltBrush}"
                      CanContentScroll="False">
            <Canvas x:Name="RootCanvas"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    ClipToBounds="False"/>
        </ScrollViewer>

        <!-- Drag this divider to choose how much room lane names use. -->
        <Border x:Name="LaneHeaderResizeGrip"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Width="10"
                HorizontalAlignment="Right"
                Panel.ZIndex="10"
                Background="Transparent"
                Cursor="SizeWE"
                ToolTip="ドラッグで幅を調整 / ダブルクリックで自動フィット">
            <Border Width="1"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource AppBorderStrongBrush}"
                    Opacity="0.45"/>
        </Border>
    </Grid>
</UserControl>
